# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase project "directaid" (Dashboard -> Project Settings -> API).
# Copy these into .env.local; the anon/publishable key is safe for the browser because tables use row level security.
VITE_SUPABASE_URL="https://vwpqyjodnupmndbtghud.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-only settings for the User Accounts page (api/admin-users.ts).
# NEVER prefix these with VITE_ - that would ship the service role key to every browser.
# Set them in Vercel -> Settings -> Environment Variables (type: Secret), not in the frontend.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
# Comma-separated emails allowed to manage logins
ADMIN_EMAILS="admin@example.com"
